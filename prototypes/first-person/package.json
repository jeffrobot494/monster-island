{
  "name": "humans-and-monsters-fp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "voice:prepare": "python scripts/prepare-voice-test.py",
    "voice:build": "node scripts/build-voice-test.mjs && node scripts/vendor-rundot.mjs dist-voice",
    "voice:test": "node scripts/test-voice-test.mjs",
    "voice": "node scripts/serve-voice-test.mjs",
    "dev:local": "VITE_PLATFORM=local vite",
    "dev": "VITE_PLATFORM=local vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:run": "VITE_RUNDOT=1 npm run build && node scripts/vendor-rundot.mjs",
    "deploy": "npm run build:run && rundot deploy --ignore-checks sandbox-blocked-modals",
    "arena": "vite --config vite.arena.config.ts",
    "arena:test": "vitest run --config vite.arena.config.ts",
    "arena:typecheck": "tsc --noEmit -p tsconfig.arena.json",
    "arena:fork": "node scripts/arena.mjs fork",
    "arena:status": "node scripts/arena.mjs status",
    "arena:diff": "node scripts/arena.mjs diff",
    "arena:sync": "node scripts/arena.mjs sync",
    "arena:promote": "node scripts/arena.mjs promote",
    "arena:drop": "node scripts/arena.mjs drop"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "5.29.1",
    "acorn": "^8.19.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
