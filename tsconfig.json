{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "dev", "vite.config.ts"], "exclude": ["test/old"]
}
